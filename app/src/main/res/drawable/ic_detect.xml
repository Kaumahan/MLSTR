<?xml version="1.0" encoding="utf-8"?>
<!--
  "Scan / detect" icon: a viewfinder / QR-scan style symbol.
  Four corner brackets around a centre dot — conveys "detecting from screen".
  Drawn at 24dp nominal size; tinted by the parent's tint/colorFilter.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Top-left bracket -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#C5CBD8"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M4,9 L4,4 L9,4" />

    <!-- Top-right bracket -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#C5CBD8"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M15,4 L20,4 L20,9" />

    <!-- Bottom-right bracket -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#C5CBD8"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M20,15 L20,20 L15,20" />

    <!-- Bottom-left bracket -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#C5CBD8"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M9,20 L4,20 L4,15" />

    <!-- Centre dot -->
    <path
        android:fillColor="#C5CBD8"
        android:pathData="M12,10.5 a1.5,1.5 0 1 1 0,3 a1.5,1.5 0 0 1 0,-3 Z" />

    <!-- Horizontal scan line -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#C5CBD8"
        android:strokeWidth="1.2"
        android:strokeAlpha="0.55"
        android:pathData="M7,12 L17,12" />
</vector>
